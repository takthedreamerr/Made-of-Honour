rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    match /guest-album/{userId}/{photoId}.jpg {

      /*
        Any authenticated wedding guest can
        view the shared photographs.
      */
      allow read:
        if request.auth != null;


      /*
        A guest can only upload into their own
        anonymous Firebase user folder.
      */
      allow write:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';

    }

  }

}